{
  "info": {
    "name": "Foro API - users + forum",
    "description": "Solicitudes para servicios locales en puertos 8081 y 8082. Cada solicitud protegida obtiene automáticamente un token con las cuentas de demostración; no requiere variables ni entorno de Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login admin y validar identidad",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login admin 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.tokenType).to.eql('Bearer');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"DemoPass123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:8081/api/auth/login"
      }
    },
    {
      "name": "2. Identidad admin",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "    url: 'http://localhost:8081/api/auth/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ username: 'admin', password: 'DemoPass123!' }) }",
              "}, (error, response) => {",
              "    if (error || !response || response.code !== 200) {",
              "        throw new Error('No se pudo iniciar sesión con la cuenta de demostración.');",
              "    }",
              "    const token = response.json().token;",
              "    if (!token) { throw new Error('La respuesta de login no contiene un token.'); }",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Identidad admin 200', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().role).to.eql('ADMIN');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8081/api/auth/me"
      }
    },
